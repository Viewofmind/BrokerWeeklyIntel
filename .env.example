# =============================================================================
# BrokerWeeklyIntel - Environment Configuration
# Copy this file to .env (never commit .env) and fill real values
# =============================================================================

# -----------------------------------------------------------------------------
# Data Collection Sources
# -----------------------------------------------------------------------------
# X / Twitter (recommended: Bearer Token with Essential access or higher)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Apify (primary production-grade scraping platform - https://apify.com)
# Get token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token
ENABLE_APIFY=true   # Set to true once you have a real token (enables Reddit + multi-platform actors)

# Reddit (PRAW or Apify actor)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="BrokerWeeklyIntel/1.0 (+https://github.com/yourorg/BrokerWeeklyIntel)"

# YouTube Data API (for video comments & transcripts)
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Advanced Analysis (Optional but powerful)
# -----------------------------------------------------------------------------
# MiroFish-Offline for high-quality offline topic clustering & sentiment
# https://github.com/nikmcfly/MiroFish-Offline
MIROFISH_ENABLED=false
MIROFISH_MODEL_PATH=          # local path or leave empty to skip
MIROFISH_DOCKER_IMAGE=        # e.g. ghcr.io/nikmcfly/mirofish-offline:latest

# LLM keys for summarization, feature extraction, and nuanced scoring (optional)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Storage & Persistence
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./backend/data/broker_intel.db
# Production example: postgresql+psycopg://user:pass@localhost:5432/broker_intel

# How many weeks of historical snapshots to keep
KEEP_HISTORICAL_WEEKS=52

# -----------------------------------------------------------------------------
# Scheduling & Automation
# -----------------------------------------------------------------------------
WEEKLY_ANALYSIS_DAY=Sunday
WEEKLY_ANALYSIS_TIME=08:30          # 24h format, Asia/Kolkata preferred
TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Brokers to Track (exact spelling used in all searches & scoring)
# -----------------------------------------------------------------------------
BROKERS=Zerodha,Groww,Angel One,Upstox,Fyers,ICICI Direct,5Paisa,Kotak Securities,HDFC Sky,Sharekhan

# -----------------------------------------------------------------------------
# Report Generation
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIR=./reports
GENERATE_MARKDOWN=true
GENERATE_PDF=true
PDF_PAGE_SIZE=A4

# -----------------------------------------------------------------------------
# Backend API & Dashboard
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Development & Debugging
# -----------------------------------------------------------------------------
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
