# BrokerWeeklyIntel Environment Configuration
# Copy this file to .env and fill in your values.

# === Data Sources ===
# Apify API token for Reddit (and future) scraping via Apify Store actors.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_your_token_here
ENABLE_APIFY=true

# Firecrawl API key for high-quality web scraping (clean Markdown + metadata)
# Get one at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
ENABLE_FIRECRAWL=true

# Twitter/X Bearer Token (for autonomous X collection fallback)
TWITTER_BEARER_TOKEN=

# === Connector Toggles ===
# Enable advanced connectors (require API keys above)
# ENABLE_APIFY and ENABLE_FIRECRAWL are set to true above once tokens are provided.

# Optional: Reddit API credentials (PRAW) if you want direct Reddit access later
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# === Other Settings ===
ENVIRONMENT=development
DEBUG=true
# DATABASE_URL=sqlite:///./backend/data/broker_intel.db
